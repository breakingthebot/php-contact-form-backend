{
  "name": "marve/php-contact-form-backend",
  "description": "Modular PHP backend for validating, storing, and emailing contact form submissions.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "symfony/mailer": "^7.4",
    "symfony/mime": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  }
}
